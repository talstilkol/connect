{
  "name": "connect-whatsapp-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.18.1"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "db:generate": "drizzle-kit generate",
    "verify:source-guardrails": "node scripts/verify-source-guardrails.mjs",
    "verify:secret-hygiene": "node scripts/verify-secret-hygiene.mjs --history",
    "verify:interface-guardrails": "node scripts/verify-interface-guardrails.mjs",
    "verify:dependency-lock": "node scripts/verify-dependency-lock.mjs",
    "verify:dependency-audit:development": "node scripts/verify-development-dependency-audit.mjs",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify:release-gate:local": "node scripts/verify-release-gate.mjs --local",
    "verify:release-gate": "node scripts/verify-release-gate.mjs",
    "verify:production-readiness": "node scripts/verify-production-readiness.mjs",
    "verify:production-readiness:json": "node scripts/verify-production-readiness.mjs --json",
    "release:manifest": "node scripts/create-release-manifest.mjs",
    "release:changelog": "node scripts/create-change-log.mjs",
    "release:verify-artifacts": "node scripts/verify-release-artifacts.mjs",
    "release:rehearse:local": "node scripts/rehearse-local-release.mjs",
    "create:team-invitation-browser-cases": "node scripts/create-team-invitation-browser-case-inventory.mjs",
    "verify:team-invitation-browser-case-file": "node scripts/verify-team-invitation-browser-case-inventory-file.mjs",
    "capture:team-invitation-browser-auth": "node scripts/capture-team-invitation-browser-auth-states.mjs",
    "verify:team-invitation-browser-auth-file": "node scripts/verify-team-invitation-browser-auth-state-file.mjs",
    "verify:team-invitation-browser-secret-files": "node scripts/verify-team-invitation-browser-secret-files.mjs",
    "verify:team-invitation-browser-evidence-file": "node scripts/verify-team-invitation-browser-evidence-file.mjs",
    "verify:team-invitation-browser-evidence-attestation": "node scripts/verify-team-invitation-browser-evidence-attestation.mjs",
    "verify:dependency-audit-evidence-attestation": "node scripts/verify-dependency-audit-evidence-attestation.mjs",
    "remove:team-invitation-browser-secret-files": "node scripts/remove-team-invitation-browser-secret-files.mjs",
    "preflight:team-invitation-browser": "node scripts/run-team-invitation-browser-e2e.mjs --preflight",
    "e2e:team-invitation-browser": "node scripts/run-team-invitation-browser-e2e.mjs",
    "e2e:bot-flow-graph-browser": "node scripts/run-bot-flow-graph-browser-e2e.mjs",
    "evidence:team-invitation-browser": "node scripts/create-team-invitation-browser-evidence.mjs",
    "evidence:dependency-audit": "node scripts/create-dependency-audit-evidence.mjs",
    "evidence:github": "node scripts/create-github-evidence.mjs",
    "evidence:cloudflare": "node scripts/create-cloudflare-evidence.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/localizations": "4.13.8",
    "@clerk/nextjs": "7.6.0",
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.3",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "9.2.0"
  },
  "devDependencies": {
    "@clerk/eslint-plugin": "0.2.0",
    "@cloudflare/vite-plugin": "1.51.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "playwright": "1.62.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.6",
    "vite": "8.2.1",
    "wrangler": "4.120.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "type": "module"
}
