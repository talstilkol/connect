{
  "name": "connect-whatsapp-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "db:generate": "drizzle-kit generate",
    "verify:source-guardrails": "node scripts/verify-source-guardrails.mjs",
    "verify:secret-hygiene": "node scripts/verify-secret-hygiene.mjs --history",
    "verify:interface-guardrails": "node scripts/verify-interface-guardrails.mjs",
    "verify:dependency-lock": "node scripts/verify-dependency-lock.mjs",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify:release-gate:local": "node scripts/verify-release-gate.mjs --local",
    "verify:release-gate": "node scripts/verify-release-gate.mjs",
    "verify:production-readiness": "node scripts/verify-production-readiness.mjs",
    "release:manifest": "node scripts/create-release-manifest.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/localizations": "4.13.8",
    "@clerk/nextjs": "7.6.0",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
