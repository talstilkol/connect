{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "railpackVersion": "0.39.0",
    "buildCommand": "node scripts/verify-railway-runtime-imports.mjs"
  },
  "deploy": {
    "startCommand": "node scripts/start-railway-bullmq-worker.mjs",
    "healthcheckPath": null,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
