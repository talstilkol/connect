{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:connect:d02:a8:normative-registry-schema:2026-08-30",
  "title": "Connect D02-A8 Normative Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactId",
    "schemaVersion",
    "canonicalization",
    "sourceCut",
    "safeState",
    "frozenInputs",
    "authorityChain",
    "predecessorClauseUniverses",
    "authorityConflict",
    "modelSelectionAuthority",
    "approvalRegistry",
    "a6FindingRegistry",
    "a7FindingRegistry",
    "aiProfileMembers",
    "promptPolicy",
    "accountParentRows",
    "accountChildren",
    "legalPrivacyMembers",
    "officialSourceReceipts",
    "rootDefinitions",
    "rootStates"
  ],
  "properties": {
    "artifactId": {
      "type": "string",
      "const": "CONNECT-D02-A8-NORMATIVE-REGISTRY-2026-08-30"
    },
    "schemaVersion": {
      "type": "string",
      "const": "D02-A8-SCHEMA-1"
    },
    "canonicalization": {
      "$ref": "#/$defs/Canonicalization"
    },
    "sourceCut": {
      "$ref": "#/$defs/Timestamp"
    },
    "safeState": {
      "$ref": "#/$defs/SafeState"
    },
    "frozenInputs": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "$ref": "#/$defs/FrozenInput"
      }
    },
    "authorityChain": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/AuthorityNode"
      }
    },
    "predecessorClauseUniverses": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/PredecessorClauseUniverse"
      }
    },
    "authorityConflict": {
      "$ref": "#/$defs/AuthorityConflict"
    },
    "modelSelectionAuthority": {
      "$ref": "#/$defs/ModelSelectionAuthority"
    },
    "approvalRegistry": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/Approval"
      }
    },
    "a6FindingRegistry": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/Finding"
      }
    },
    "a7FindingRegistry": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/Finding"
      }
    },
    "aiProfileMembers": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": {
        "$ref": "#/$defs/ProfileMember"
      }
    },
    "promptPolicy": {
      "$ref": "#/$defs/PromptPolicy"
    },
    "accountParentRows": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/AccountParent"
      }
    },
    "accountChildren": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/AccountChild"
      }
    },
    "legalPrivacyMembers": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/LegalMember"
      }
    },
    "officialSourceReceipts": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "$ref": "#/$defs/SourceReceipt"
      }
    },
    "rootDefinitions": {
      "type": "array",
      "minItems": 12,
      "items": {
        "$ref": "#/$defs/RootDefinition"
      }
    },
    "rootStates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/RootState"
      }
    }
  },
  "$defs": {
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "NullableSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/Sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "LogicalPath": {
      "type": "string",
      "pattern": "^docs/[^\\\\]*$"
    },
    "Timestamp": {
      "type": "string",
      "pattern": "^2026-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "SafeState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aiRuntime",
        "gate29",
        "developmentFreeze",
        "repositoryVisibility",
        "planningAcceptance",
        "aiAdmission",
        "runtimePermit"
      ],
      "properties": {
        "aiRuntime": {
          "const": "OFF"
        },
        "gate29": {
          "const": "BLOCKED"
        },
        "developmentFreeze": {
          "const": "ACTIVE"
        },
        "repositoryVisibility": {
          "const": "PUBLIC"
        },
        "planningAcceptance": {
          "const": "MISSING"
        },
        "aiAdmission": {
          "const": "MISSING"
        },
        "runtimePermit": {
          "const": "MISSING"
        }
      }
    },
    "Canonicalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "domainPrefix",
        "idPolicy"
      ],
      "properties": {
        "algorithm": {
          "const": "RFC8785-JCS-SHA256"
        },
        "domainPrefix": {
          "const": "CONNECT-D02-A8"
        },
        "idPolicy": {
          "const": "DETERMINISTIC-ONLY-NO-RANDOMNESS"
        }
      }
    },
    "FrozenInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputId",
        "path",
        "sha256",
        "lines",
        "words",
        "bytes",
        "authorityClass"
      ],
      "properties": {
        "inputId": {
          "type": "string",
          "pattern": "^D02A8-IN-[0-9]{3}$"
        },
        "path": {
          "$ref": "#/$defs/LogicalPath"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "lines": {
          "type": "integer",
          "minimum": 1
        },
        "words": {
          "type": "integer",
          "minimum": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "authorityClass": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "AuthorityNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "sequence",
        "inputId",
        "scope",
        "authorityClass",
        "predecessorId",
        "d02Disposition",
        "modelDisposition",
        "state"
      ],
      "properties": {
        "nodeId": {
          "type": "string",
          "pattern": "^D02A8-AUTH-[0-9]{3}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "inputId": {
          "type": "string",
          "pattern": "^D02A8-IN-[0-9]{3}$"
        },
        "scope": {
          "const": "D02"
        },
        "authorityClass": {
          "enum": [
            "USER-DIRECTIVE",
            "RESEARCHED-DECISION",
            "ENGINEERING-RECONCILIATION",
            "SEMANTIC-SUCCESSOR"
          ]
        },
        "predecessorId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^D02A8-AUTH-[0-9]{3}$"
            }
          ]
        },
        "d02Disposition": {
          "enum": [
            "PRESERVE-OPENAI-RESPONSES-AND-EVAL",
            "SUPERSEDE-MODEL-ORDER-ONLY",
            "PRESERVE-WITH-STRONGER-CONTROLS"
          ]
        },
        "modelDisposition": {
          "enum": [
            "NO-MODEL-SELECTED",
            "LUNA-FIRST-RESEARCH-CANDIDATE",
            "TERRA-FIRST-UNACCEPTED-CANDIDATE",
            "INHERIT-TYPED-BLOCKED-SELECTION"
          ]
        },
        "state": {
          "enum": [
            "AUTHORITATIVE-DIRECTIVE",
            "HISTORICAL-SUPERSEDED-IN-MODEL-ORDER",
            "CANDIDATE-NOT-ACCEPTED"
          ]
        }
      }
    },
    "AuthorityConflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflictId",
        "olderNodeId",
        "newerNodeId",
        "scope",
        "deterministicCurrentPolicy",
        "resolutionRule",
        "unresolvedAmbiguityCount"
      ],
      "properties": {
        "conflictId": {
          "const": "D02A8-CONFLICT-001"
        },
        "olderNodeId": {
          "const": "D02A8-AUTH-002"
        },
        "newerNodeId": {
          "const": "D02A8-AUTH-003"
        },
        "scope": {
          "const": "MODEL-ORDER"
        },
        "deterministicCurrentPolicy": {
          "const": "NO-OPERATIONAL-MODEL-SELECTED"
        },
        "resolutionRule": {
          "const": "REQUIRE-ACCEPTED-TYPED-MODEL-SELECTION-AUTHORITY"
        },
        "unresolvedAmbiguityCount": {
          "const": 0
        }
      }
    },
    "PredecessorClauseUniverse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "universeId",
        "nodeId",
        "inputId",
        "derivationMode",
        "memberSelector",
        "memberLocators",
        "expectedMemberCount",
        "defaultDisposition",
        "overrideDispositions",
        "coveragePredicate"
      ],
      "properties": {
        "universeId": {
          "type": "string",
          "pattern": "^D02A8-PCU-00[1-6]$"
        },
        "nodeId": {
          "type": "string",
          "pattern": "^D02A8-AUTH-00[1-6]$"
        },
        "inputId": {
          "type": "string",
          "pattern": "^D02A8-IN-00[1-6]$"
        },
        "derivationMode": {
          "enum": [
            "EXPLICIT-D02-LOCATORS",
            "NUMBERED-CLAUSE-REGEX-WHOLE-DOCUMENT"
          ]
        },
        "memberSelector": {
          "type": "string",
          "minLength": 1
        },
        "memberLocators": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expectedMemberCount": {
          "type": "integer",
          "minimum": 1
        },
        "defaultDisposition": {
          "type": "string",
          "minLength": 1
        },
        "overrideDispositions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "memberId",
              "disposition"
            ],
            "properties": {
              "memberId": {
                "type": "string",
                "minLength": 1
              },
              "disposition": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "coveragePredicate": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ModelSelectionAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptId",
        "authorityType",
        "issuerClass",
        "scope",
        "candidateRecommendation",
        "acceptedSelection",
        "issuedAt",
        "expiresAt",
        "revocationRoot",
        "state",
        "terminal"
      ],
      "properties": {
        "receiptId": {
          "const": "D02A8-MSA-001"
        },
        "authorityType": {
          "const": "MODEL-SELECTION-AUTHORITY"
        },
        "issuerClass": {
          "const": "PRODUCT-PLUS-AI-ENGINEERING-PLUS-FINANCE"
        },
        "scope": {
          "const": "D02-PILOT-EXACT-PROFILE"
        },
        "candidateRecommendation": {
          "const": "gpt-5.6-terra"
        },
        "acceptedSelection": {
          "type": "null"
        },
        "issuedAt": {
          "type": "null"
        },
        "expiresAt": {
          "type": "null"
        },
        "revocationRoot": {
          "type": "null"
        },
        "state": {
          "const": "MISSING"
        },
        "terminal": {
          "const": "MODEL-SELECTION-AUTHORITY-MISSING"
        }
      }
    },
    "Approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalId",
        "domain",
        "required",
        "subjectRootClass",
        "state"
      ],
      "properties": {
        "approvalId": {
          "type": "string",
          "pattern": "^D02A8-APR-00[1-6]$"
        },
        "domain": {
          "enum": [
            "PRODUCT",
            "AI-ENGINEERING",
            "SECURITY",
            "PRIVACY-LEGAL",
            "FINANCE-COST",
            "WHATSAPP-META-POLICY"
          ]
        },
        "required": {
          "const": true
        },
        "subjectRootClass": {
          "const": "AI-ADMISSION-CANDIDATE"
        },
        "state": {
          "const": "ABSENT"
        }
      }
    },
    "Finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findingId",
        "severity",
        "source",
        "state",
        "candidateDisposition",
        "independentClosureRoot",
        "acceptanceCredit",
        "noMergeKey"
      ],
      "properties": {
        "findingId": {
          "type": "string",
          "pattern": "^D02-A[67]-IHR-F[0-9]{3}$"
        },
        "severity": {
          "enum": [
            "P1",
            "P2"
          ]
        },
        "source": {
          "enum": [
            "A6",
            "A7"
          ]
        },
        "state": {
          "const": "OPEN"
        },
        "candidateDisposition": {
          "enum": [
            "PRESERVED-A7-PROPOSAL",
            "A8-CANDIDATE-REMEDIATED"
          ]
        },
        "independentClosureRoot": {
          "type": "null"
        },
        "acceptanceCredit": {
          "const": 0
        },
        "noMergeKey": {
          "type": "string",
          "pattern": "^D02-A[67]-IHR-F[0-9]{3}$"
        }
      }
    },
    "ProfileMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memberId",
        "semanticKey",
        "required",
        "rootState"
      ],
      "properties": {
        "memberId": {
          "type": "string",
          "pattern": "^D02A8-AIP-[0-9]{3}$"
        },
        "semanticKey": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "const": true
        },
        "rootState": {
          "const": "MISSING"
        }
      }
    },
    "PromptPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "contentMode",
        "artifactPath",
        "contentSha256",
        "providerReusablePromptObjects",
        "providerPromptEndpoint",
        "responsesPromptObjectField",
        "deprecationAnnounced",
        "shutdownScheduled",
        "sourceReceiptId",
        "state",
        "terminal"
      ],
      "properties": {
        "owner": {
          "const": "CONNECT"
        },
        "contentMode": {
          "const": "APPLICATION-OWNED-EXACT-BYTES"
        },
        "artifactPath": {
          "type": "null"
        },
        "contentSha256": {
          "type": "null"
        },
        "providerReusablePromptObjects": {
          "const": false
        },
        "providerPromptEndpoint": {
          "const": "FORBIDDEN:/v1/prompts"
        },
        "responsesPromptObjectField": {
          "const": "FORBIDDEN"
        },
        "deprecationAnnounced": {
          "const": "2026-06-03"
        },
        "shutdownScheduled": {
          "const": "2026-11-30"
        },
        "sourceReceiptId": {
          "const": "D02A8-SRC-009"
        },
        "state": {
          "const": "MISSING-CONNECT-PROMPT-BYTES"
        },
        "terminal": {
          "const": "PROMPT-BYTES-MISSING"
        }
      }
    },
    "AccountParent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rowId",
        "semanticKey",
        "required",
        "childIds",
        "state"
      ],
      "properties": {
        "rowId": {
          "type": "string",
          "pattern": "^D02A8-AR-[0-9]{3}$"
        },
        "semanticKey": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "const": true
        },
        "childIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^D02A8-AR-006-[PF]$"
          }
        },
        "state": {
          "const": "ABSENT"
        }
      }
    },
    "AccountChild": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "childId",
        "parentId",
        "semanticKey",
        "sourceAuthority",
        "issuerClass",
        "scope",
        "observedAt",
        "expiresAt",
        "freshnessPolicy",
        "revocationRoot",
        "state"
      ],
      "properties": {
        "childId": {
          "type": "string",
          "pattern": "^D02A8-AR-006-[PF]$"
        },
        "parentId": {
          "const": "D02A8-AR-006"
        },
        "semanticKey": {
          "enum": [
            "PROVIDER-RATE-SPEND-LIMITS",
            "CONNECT-FINANCE-BUDGET"
          ]
        },
        "sourceAuthority": {
          "enum": [
            "OPENAI-AUTHENTICATED-ORG-PROJECT-READBACK",
            "CONNECT-FINANCE-DECISION-RECEIPT"
          ]
        },
        "issuerClass": {
          "enum": [
            "OPENAI-ACCOUNT-AUTHORITY",
            "CONNECT-FINANCE-COST-AUTHORITY"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "observedAt": {
          "type": "null"
        },
        "expiresAt": {
          "type": "null"
        },
        "freshnessPolicy": {
          "enum": [
            "AUTHENTICATED-READBACK-TTL-REQUIRED-NO-DEFAULT",
            "FINANCE-APPROVAL-EXPIRY-REQUIRED-NO-DEFAULT"
          ]
        },
        "revocationRoot": {
          "type": "null"
        },
        "state": {
          "const": "ABSENT"
        }
      }
    },
    "LegalMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memberId",
        "domain",
        "required",
        "subjectRootClass",
        "state"
      ],
      "properties": {
        "memberId": {
          "type": "string",
          "pattern": "^D02A8-LP-[0-9]{3}$"
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "const": true
        },
        "subjectRootClass": {
          "const": "AI-ADMISSION-SUBJECT"
        },
        "state": {
          "const": "ABSENT"
        }
      }
    },
    "SourceReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptId",
        "sourceId",
        "url",
        "publisherAuthority",
        "retrievedAt",
        "freshnessPolicy",
        "claimCodes",
        "observationCommitmentMode",
        "observationCommitment",
        "pageBytesPublished",
        "accepted",
        "acceptanceRoot",
        "changeDetector",
        "terminals",
        "state"
      ],
      "properties": {
        "receiptId": {
          "type": "string",
          "pattern": "^D02A8-SRC-[0-9]{3}$"
        },
        "sourceId": {
          "type": "string",
          "pattern": "^OPENAI-[A-Z0-9-]+$"
        },
        "url": {
          "type": "string",
          "pattern": "^https://developers\\.openai\\.com/"
        },
        "publisherAuthority": {
          "const": "OPENAI-OFFICIAL-DOCUMENTATION"
        },
        "retrievedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "freshnessPolicy": {
          "const": "EXACT-CUT-ONLY-RETRIEVE-NEW-RECEIPT-FOR-LATER-USE"
        },
        "claimCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9-]+$"
          }
        },
        "observationCommitmentMode": {
          "const": "JCS-SHA256-OF-RECEIPT-CLAIM-SET-NO-PAGE-BYTES"
        },
        "observationCommitment": {
          "$ref": "#/$defs/Sha256"
        },
        "pageBytesPublished": {
          "const": false
        },
        "accepted": {
          "const": false
        },
        "acceptanceRoot": {
          "type": "null"
        },
        "changeDetector": {
          "const": "RETRIEVE-AND-RECOMPUTE-CLAIM-SET-COMMITMENT"
        },
        "terminals": {
          "type": "array",
          "const": [
            "SOURCE-UNAVAILABLE",
            "SOURCE-STALE",
            "SOURCE-CHANGED",
            "SOURCE-CONFLICT"
          ]
        },
        "state": {
          "const": "OBSERVED-UNACCEPTED"
        }
      }
    },
    "RootDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootId",
        "rootClass",
        "soleProducer",
        "orderedDependencyIds",
        "successPredicate",
        "failureTerminal"
      ],
      "properties": {
        "rootId": {
          "type": "string",
          "pattern": "^D02A8-ROOT-[A-Z0-9-]+$"
        },
        "rootClass": {
          "type": "string",
          "minLength": 1
        },
        "soleProducer": {
          "type": "string",
          "minLength": 1
        },
        "orderedDependencyIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "successPredicate": {
          "type": "string",
          "minLength": 1
        },
        "failureTerminal": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "RootState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootId",
        "rootClass",
        "root",
        "state",
        "acceptanceCredit"
      ],
      "properties": {
        "rootId": {
          "enum": [
            "D02A8-ROOT-PLANNING-ACCEPTANCE",
            "D02A8-ROOT-AI-ADMISSION",
            "D02A8-ROOT-RUNTIME-PERMIT"
          ]
        },
        "rootClass": {
          "enum": [
            "D02-PLANNING-CONTRACT-ACCEPTANCE",
            "AI-PROFILE-ADMISSION",
            "AI-RUNTIME-PERMIT"
          ]
        },
        "root": {
          "type": "null"
        },
        "state": {
          "const": "MISSING"
        },
        "acceptanceCredit": {
          "const": 0
