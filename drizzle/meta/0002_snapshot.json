        "contacts_phone_e164_valid": {
          "name": "contacts_phone_e164_valid",
          "value": "length(\"contacts\".\"phone_e164\") between 2 and 16\n        and substr(\"contacts\".\"phone_e164\", 1, 1) = '+'\n        and substr(\"contacts\".\"phone_e164\", 2, 1) between '1' and '9'\n        and substr(\"contacts\".\"phone_e164\", 2) not glob '*[^0-9]*'"
        },
        "contacts_mailing_status_valid": {
          "name": "contacts_mailing_status_valid",
          "value": "\"contacts\".\"mailing_status\" in ('subscribed', 'unsubscribed')"
        },
        "contacts_consent_status_valid": {
          "name": "contacts_consent_status_valid",
          "value": "\"contacts\".\"consent_status\" in ('unknown', 'granted', 'withdrawn')"
        },
        "contacts_consent_state_consistent": {
          "name": "contacts_consent_state_consistent",
          "value": "(\n        \"contacts\".\"consent_status\" = 'unknown'\n        and \"contacts\".\"mailing_status\" = 'unsubscribed'\n        and \"contacts\".\"consent_source\" is null\n        and \"contacts\".\"consent_recorded_at\" is null\n        and \"contacts\".\"consent_withdrawn_at\" is null\n      ) or (\n        \"contacts\".\"consent_status\" = 'granted'\n        and \"contacts\".\"mailing_status\" = 'subscribed'\n        and \"contacts\".\"consent_source\" is not null\n        and \"contacts\".\"consent_recorded_at\" is not null\n        and \"contacts\".\"consent_withdrawn_at\" is null\n      ) or (\n        \"contacts\".\"consent_status\" = 'withdrawn'\n        and \"contacts\".\"mailing_status\" = 'unsubscribed'\n        and \"contacts\".\"consent_source\" is not null\n        and \"contacts\".\"consent_recorded_at\" is not null\n        and \"contacts\".\"consent_withdrawn_at\" is not null\n      )"
        },
        "contacts_version_positive": {
          "name": "contacts_version_positive",
          "value": "\"contacts\".\"version\" >= 1"
        }
      }
